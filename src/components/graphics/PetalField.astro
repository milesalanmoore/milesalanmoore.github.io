---
/* ============================================================
   🌸  PETAL FIELD — falling cherry blossom petals
   ------------------------------------------------------------
   A fixed, full-viewport overlay of drifting petals. It sits
   behind the (opaque, dark) nav but in front of page content,
   purely decorative (pointer-events:none). Petal colors come
   from the --petal-* theme variables. The keyframes live in
   global.css. Animation is disabled under prefers-reduced-motion.
   Tune `count` for density.
   ============================================================ */
interface Props {
  /** number of petals on screen (more = denser) */
  count?: number;
}

const { count = 19 } = Astro.props;

const anims = ["petal-drift-right", "petal-drift-left", "petal-drift-sway"];
const colors = [
  "var(--petal-1)",
  "var(--petal-2)",
  "var(--petal-3)",
  "var(--petal-4)",
];

// Deterministic spread so SSR output is stable (no hydration jank).
const petals = Array.from({ length: count }, (_, i) => {
  const left = 4 + ((i * 67) % 92); // spread 4%–96%
  const dur = 12 + ((i * 5) % 8); // 12s–19s
  const delay = -((i * 3.3) % 18); // negative → mid-flight on load
  const w = 9 + (i % 4); // 9–12px
  return {
    left: `${left}%`,
    dur: `${dur}s`,
    delay: `${delay.toFixed(1)}s`,
    anim: anims[i % anims.length],
    color: colors[i % colors.length],
    w,
    h: Math.round(w * 1.33),
  };
});
---

<div class="petal-field" aria-hidden="true">
  {
    petals.map((p) => (
      <div
        class="petal"
        style={`left:${p.left}; animation:${p.anim} ${p.dur} linear ${p.delay} infinite both;`}
      >
        <svg width={p.w} height={p.h} viewBox="0 0 12 16">
          <path
            d="M6,0 C9.5,2 11,7 9,12 C8,15 4,15 3,12 C1,7 2.5,2 6,0 Z"
            fill={p.color}
            opacity="0.68"
          />
        </svg>
      </div>
    ))
  }
</div>

<style>
  .petal-field {
    position: fixed;
    inset: 0;
    z-index: 50; /* above content, below the sticky nav (z-index 100) */
    pointer-events: none;
    overflow: hidden;
  }

  .petal {
    position: absolute;
    top: 0;
    will-change: transform, opacity;
  }
</style>
