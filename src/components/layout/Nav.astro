---
const navLinks = [
  { href: "/about/", label: "About" },
  { href: "/research/", label: "Research" },
  { href: "/news/", label: "News" },
];

const pathname = new URL(Astro.request.url).pathname;

function isActive(href: string) {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
}
---

<header class="site-header">
  <nav class="nav-inner" aria-label="Site navigation">
    <a href="/" class="nav-brand" aria-label="Miles A. Moore — Home">M.A. Moore</a>

    <div class="nav-right">
      <ul class="nav-links" role="list">
        {
          navLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class:list={["nav-link", { "nav-active": isActive(href) }]}
                aria-current={isActive(href) ? "page" : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/cv/" class:list={["nav-cv", { "nav-active": isActive("/cv/") }]}>CV</a>
        </li>
      </ul>

      <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>

  <!-- Mobile drawer -->
  <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
    <ul role="list">
      {
        navLinks.map(({ href, label }) => (
          <li>
            <a href={href} class:list={["mobile-link", { "mobile-active": isActive(href) }]}>
              {label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/cv/" class:list={["mobile-link", { "mobile-active": isActive("/cv/") }]}>CV</a>
      </li>
    </ul>
  </div>
</header>

<script>
  const hamburger = document.getElementById("hamburger");
  const drawer = document.getElementById("mobile-drawer");

  hamburger?.addEventListener("click", () => {
    const open = hamburger.getAttribute("aria-expanded") === "true";
    hamburger.setAttribute("aria-expanded", String(!open));
    drawer?.setAttribute("aria-hidden", String(open));
    drawer?.classList.toggle("open", !open);
    hamburger.classList.toggle("is-open", !open);
  });

  drawer?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => {
      drawer.classList.remove("open");
      drawer.setAttribute("aria-hidden", "true");
      hamburger?.setAttribute("aria-expanded", "false");
      hamburger?.classList.remove("is-open");
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--ink);
  }

  .nav-inner {
    max-width: var(--content-width);
    margin-inline: auto;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: clamp(1.25rem, 5vw, 4rem);
  }

  .nav-brand {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--paper-light);
  }

  .nav-brand:hover { color: #fff; }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 2.25rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2.25rem;
    list-style: none;
  }

  .nav-link {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.81rem;
    letter-spacing: 0.04em;
    color: var(--nav-muted);
  }

  .nav-link:hover { color: var(--paper-light); }
  .nav-link.nav-active { color: var(--paper-light); }

  .nav-cv {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--paper-light);
    border: 1px solid rgba(245, 240, 234, 0.28);
    padding: 6px 18px;
    border-radius: var(--radius-xs);
    transition: var(--transition-hover);
  }

  .nav-cv:hover,
  .nav-cv.nav-active {
    color: var(--ink);
    background: var(--paper-light);
    border-color: var(--paper-light);
  }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2rem;
    height: 2rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
  }

  .hamburger span {
    display: block;
    width: 100%;
    height: 1.5px;
    background: var(--paper-light);
    border-radius: 2px;
    transition: var(--transition-hover);
  }

  .hamburger.is-open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .hamburger.is-open span:nth-child(2) { opacity: 0; }
  .hamburger.is-open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  /* Mobile drawer */
  .mobile-drawer {
    display: none;
    background: var(--ink);
    border-top: 1px solid rgba(245, 240, 234, 0.1);
    padding: 0.5rem clamp(1.25rem, 5vw, 4rem) 1.25rem;
  }

  .mobile-drawer.open { display: block; }

  .mobile-drawer ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-link {
    display: block;
    padding: 0.65rem 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    color: var(--nav-muted);
    border-bottom: 1px solid rgba(245, 240, 234, 0.06);
  }

  .mobile-link:hover,
  .mobile-link.mobile-active { color: var(--paper-light); }

  @media (max-width: 768px) {
    .nav-links { display: none; }
    .hamburger { display: flex; }
  }
</style>
