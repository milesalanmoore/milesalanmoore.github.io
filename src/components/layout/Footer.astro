---
import { socials } from "../../data/socials";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <span class="footer-copy">&copy; {year} Miles Alan Moore</span>

    <nav class="footer-socials" aria-label="Professional links">
      {
        socials.map(({ label, href, icon }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={label}
            title={label}
            class="social-link"
          >
            <i class={icon} aria-hidden="true" />
          </a>
        ))
      }
    </nav>

    <span class="footer-org">
      University of Colorado Boulder
      <span class="footer-sep">·</span>
      <a href="/ai/">AI use</a>
      <span class="footer-sep">·</span>
      <a href="/license/">License</a>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--paper);
    border-top: 1px solid var(--border-2);
    position: relative;
    z-index: 60; /* keep above the petal overlay */
  }

  .footer-inner {
    max-width: var(--content-width);
    margin-inline: auto;
    padding: 1.5rem clamp(1.25rem, 5vw, 4rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-copy,
  .footer-org {
    font-size: 0.78rem;
    font-weight: 300;
    color: var(--text-faint);
  }

  .footer-org a { color: var(--text-faint); }
  .footer-org a:hover { color: var(--clay); }
  .footer-sep { opacity: 0.45; margin-inline: 0.3rem; }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    color: var(--text-muted);
    font-size: 0.95rem;
    transition: var(--transition-hover);
  }

  .social-link:hover {
    color: var(--ink);
    background: rgba(88, 72, 62, 0.08);
  }

  @media (max-width: 760px) {
    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
    .footer-socials { order: -1; }
  }
</style>
