---
/**
 * The site's only layout. Nav and footer live here rather than in
 * separate components — there is one of each, and keeping them
 * together makes the page chrome readable in a single file.
 */
import "../styles/global.css";
import { socials, email, cvPath } from "../data/socials";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "PhD student at CU Boulder and DOE CSGF Fellow. Bayesian and simulation-based methods for ecological forecasting.",
  ogImage = "/assets/images/bio-photo.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === "Miles A. Moore" ? title : `${title} — Miles A. Moore`;

// Nav links. `path` is matched as a prefix so /research/<slug> still
// marks Research as current.
const navLinks = [
  { label: "About", path: "/about/" },
  { label: "Research", path: "/research/" },
  { label: "News", path: "/news/" },
  { label: "CV", path: "/cv/" },
];

const here = Astro.url.pathname;
const isCurrent = (path: string) =>
  path === "/" ? here === "/" : here.startsWith(path);

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Miles A. Moore" />
    <meta name="theme-color" content="#fdfcf9" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/assets/miles/favicon2.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..500&family=Work+Sans:wght@300;400;500;600&display=swap"
    />

    <title>{pageTitle}</title>
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="nav">
      <nav class="wrap wrap-wide nav-inner" aria-label="Primary">
        <a href="/" class="nav-name">Miles A. Moore</a>
        <div class="nav-links">
          {
            navLinks.map((link) => (
              <a
                href={link.path}
                aria-current={isCurrent(link.path) ? "page" : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap wrap-wide">
        <div class="footer-inner">
          <span>© {year} Miles A. Moore</span>
          <div class="footer-links">
            <a href={`mailto:${email}`}>Email</a>
            <a href={cvPath}>CV</a>
            {
              socials.map((s) => (
                <a href={s.href} target="_blank" rel="noopener noreferrer">
                  {s.label}
                </a>
              ))
            }
          </div>
        </div>
        <p class="footer-fine">
          <a href="/ai/">AI use policy</a> · <a href="/license/">License</a> ·
          <a href="/colophon/">Colophon</a>
        </p>
      </div>
    </footer>
  </body>
</html>
