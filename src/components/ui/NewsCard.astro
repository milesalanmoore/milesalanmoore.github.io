---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  post: CollectionEntry<"news">;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, date, description, thumbnail, tags } = post.data;

const dateStr = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<article class:list={["news-card", { featured }]}>
  <a href={`/news/${post.slug}/`} class="news-link">
    {
      thumbnail && (
        <div class="news-thumb">
          <Image src={thumbnail} alt={title} width={400} height={240} class="news-img" />
        </div>
      )
    }
    <div class="news-body">
      <time class="news-date" datetime={date.toISOString()}>{dateStr}</time>
      <h3 class="news-title">{title}</h3>
      {description && <p class="news-desc">{description}</p>}
      {
        tags && tags.length > 0 && (
          <div class="news-tags">
            {tags.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </div>
        )
      }
    </div>
  </a>
</article>

<style>
  .news-card {
    background: var(--paper-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    transition: var(--transition-hover);
  }

  .news-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .news-link {
    display: flex;
    flex-direction: column;
    color: inherit;
    height: 100%;
  }

  .news-thumb {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: var(--paper-2);
  }

  .news-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .news-card:hover .news-img { transform: scale(1.04); }

  .news-body {
    padding: 1.15rem 1.25rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }

  .news-date {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .news-title {
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 500;
    line-height: 1.38;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0;
  }

  .news-card:hover .news-title { color: var(--clay); }

  .news-desc {
    font-size: 0.82rem;
    font-weight: 300;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .news-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.25rem;
  }
</style>
