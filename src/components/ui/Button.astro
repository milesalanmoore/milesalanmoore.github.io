---
interface Props {
  href?: string;
  variant?: "primary" | "ghost" | "outline";
  size?: "sm" | "md";
  external?: boolean;
  icon?: string;
  download?: boolean;
  class?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  external = false,
  icon,
  download = false,
  class: className,
} = Astro.props;

const Tag = href ? "a" : "button";
const externalProps = external
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};
---

<Tag
  href={href}
  class:list={["btn", `btn-${variant}`, `btn-${size}`, className]}
  {...externalProps}
  download={download || undefined}
>
  {icon && <i class={`fa-solid fa-${icon}`} aria-hidden="true"></i>}
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border-radius: var(--radius-xs);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    cursor: pointer;
    transition: var(--transition-hover);
    white-space: nowrap;
    border: none;
    font-family: var(--font-display);
    font-size: inherit;
    line-height: 1;
  }

  /* Sizes */
  .btn-md { padding: 0.6rem 1.3rem; font-size: 0.82rem; }
  .btn-sm { padding: 0.4rem 0.9rem; font-size: 0.76rem; }

  /* Primary */
  .btn-primary {
    background: var(--clay);
    color: var(--paper-light);
  }
  .btn-primary:hover {
    background: var(--clay-h);
    color: #fff;
    box-shadow: var(--shadow-sm);
  }

  /* Ghost */
  .btn-ghost {
    background: rgba(88, 72, 62, 0.06);
    color: var(--text-muted);
    border: 1px solid var(--border-2);
  }
  .btn-ghost:hover {
    background: rgba(88, 72, 62, 0.12);
    color: var(--ink-soft);
  }

  /* Outline */
  .btn-outline {
    background: transparent;
    color: var(--clay);
    border: 1px solid var(--clay);
  }
  .btn-outline:hover {
    background: var(--clay);
    color: var(--paper-light);
  }
</style>
