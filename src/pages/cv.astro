---
import Layout from "../components/Layout.astro";
import { education, experience, teaching, presentations } from "../data/cv";
import { cvPath } from "../data/socials";

const sections = [
  { heading: "Education", entries: education },
  { heading: "Research Experience", entries: experience },
  { heading: "Teaching", entries: teaching },
  { heading: "Presentations", entries: presentations },
];
---

<Layout
  title="CV"
  description="Curriculum vitae of Miles A. Moore: education, research experience, teaching, and presentations."
>
  <div class="wrap page-head">
    <p class="eyebrow">Curriculum Vitae</p>
    <h1>CV</h1>
    <div class="btn-row cv-actions">
      <a class="btn btn-accent" href={cvPath}>Download PDF</a>
    </div>
  </div>

  {
    sections.map((section) => (
      <section class="wrap band">
        <h2>{section.heading}</h2>
        <div class="entries">
          {section.entries.map((e) => (
            <div class="entry">
              <div class="entry-meta">
                <span>{e.date}</span>
              </div>
              <h3 class="entry-title">
                {e.title}
                {e.note && <span class="note">{e.note}</span>}
              </h3>
              <p class="entry-sub">{e.sub}</p>
            </div>
          ))}
        </div>
      </section>
    ))
  }

  <section class="wrap band">
    <p class="cv-note">
      A full publication list is on the <a href="/research/">Research</a> page.
    </p>
  </section>
</Layout>

<style>
  .cv-actions {
    margin-top: 1.25rem;
  }

  .note {
    display: inline-block;
    font-family: var(--sans);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 100px;
    padding: 0.05rem 0.6rem;
    margin-left: 0.55rem;
    vertical-align: middle;
    letter-spacing: 0.02em;
  }

  .cv-note {
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
