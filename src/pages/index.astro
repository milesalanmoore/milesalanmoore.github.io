---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Nav from "../components/layout/Nav.astro";
import Footer from "../components/layout/Footer.astro";
import BlossomTree from "../components/graphics/BlossomTree.astro";
import RecentNews from "../components/sections/RecentNews.astro";
import { hero, researchIntro, researchAreas, skills } from "../data/home";
import { socials } from "../data/socials";
---

<BaseLayout
  title="Miles A. Moore — Computational Ecologist"
  description="PhD student at CU Boulder & DOE CSGF Fellow. Bayesian and simulation-based methods for ecological forecasting in alpine and agricultural systems."
>
  <Nav />
  <main id="main-content">

    <!-- ============== HERO ============== -->
    <section class="hero">
      <div class="hero-namebar container">
        <div class="hero-namerow">
          <h1 class="hero-name">{hero.name}</h1>
          <div class="hero-monogram-col">
            <img
              class="hero-headshot"
              src="assets/images/bio-photo.jpg"
              alt="Portrait of Miles A. Moore"
              width="100"
              height="100"
            />
            <span class="hero-role">{hero.role}</span>
          </div>
        </div>
        <div class="name-rule"></div>
      </div>

      <div class="hero-grid container">
        <!-- Left: bio + tabular social links -->
        <div class="hero-bio">
          <div class="hero-badges">
            {
              hero.badges.map((b, i) => (
                <span class:list={["hero-badge", { "is-clay": i === 0 }]}>{b}</span>
              ))
            }
          </div>
          <p class="hero-blurb">{hero.bio}</p>

          <div class="hero-socials">
            {
              socials.map((s) => (
                <div class="hero-social-row">
                  <span class="hero-social-label">{s.label}</span>
                  <a href={s.href} target="_blank" rel="noopener noreferrer" class="hero-social-link">
                    {s.handle}
                  </a>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Right: cherry blossom tree -->
        <div class="hero-tree">
          <BlossomTree />
        </div>
      </div>
    </section>

    <!-- ============== RESEARCH ============== -->
    <section class="research">
      <div class="container research-grid">
        <div class="research-intro">
          <div class="eyebrow research-kicker">Research</div>
          <p>{researchIntro}</p>
          <a href="/research/" class="research-cta">View publications &rarr;</a>
        </div>
        <div class="research-cards">
          {
            researchAreas.map((area) => (
              <div class="research-card">
                <div class="research-card-title">{area.title}</div>
                <p class="research-card-blurb">{area.blurb}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============== SKILLS ============== -->
    <section class="skills">
      <div class="container skills-grid">
        {
          skills.map((group) => (
            <div class="skill-col">
              <div class="eyebrow skill-kicker">{group.category}</div>
              <div class="skill-items">
                {group.items.map((item) => (
                  <span class="skill-item">{item}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <hr class="rule" />

    <!-- ============== RECENT NEWS ============== -->
    <RecentNews />

  </main>
  <Footer />
</BaseLayout>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    background: var(--paper);
    overflow: hidden;
  }

  .hero-namebar {
    padding-top: clamp(2.5rem, 6vw, 3.5rem);
    position: relative;
    z-index: 2;
  }

  .hero-namerow {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .hero-name {
    font-size: clamp(2.6rem, 8vw, 5.4rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.94;
    color: var(--ink);
    margin: 0;
  }

  .hero-monogram-col {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    padding-bottom: 0.4rem;
    flex-shrink: 0;
  }

  .hero-monogram {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: var(--avatar-grad);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--paper-light);
    letter-spacing: 0.09em;
  }

  .hero-headshot-frame {
    width: 64px;
    height: 64px;
    overflow: hidden;
    border-radius: 50%;
    border: 2px solid rgba(122, 74, 56, 0.18);
    box-shadow: 0 2px 10px rgba(46, 35, 29, 0.12);
  }

  .hero-headshot {
    width: 64px;
    height: 64px;
    display: block;
    object-fit: cover;
    object-position: 50% 10%;
    border-radius: 50%;
    border: 2px solid rgba(122, 74, 56, 0.18);
    box-shadow: 0 2px 10px rgba(46, 35, 29, 0.12);
  }

  .hero-role {
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--sage);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-align: right;
  }

  /* Two-column body */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    position: relative;
  }

  .hero-bio {
    padding: 2.4rem 2.5rem 3.5rem 0;
    position: relative;
    z-index: 2;
  }

  .hero-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.6rem;
  }

  .hero-badge {
    font-size: 0.74rem;
    font-weight: 400;
    color: var(--text-muted);
    background: rgba(88, 72, 62, 0.08);
    padding: 4px 11px;
    border-radius: var(--radius-xs);
  }

  .hero-badge.is-clay {
    color: var(--clay);
    background: rgba(122, 74, 56, 0.1);
  }

  .hero-blurb {
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.78;
    color: var(--text);
    max-width: 460px;
    margin: 0 0 2.2rem;
  }

  .hero-socials {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .hero-social-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .hero-social-label {
    font-size: 0.62rem;
    font-weight: 500;
    color: var(--label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    min-width: 58px;
  }

  .hero-social-link {
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  .hero-social-link:hover { color: var(--clay); }

  /* Tree column */
  .hero-tree {
    position: relative;
    min-height: 360px;
  }

  .hero-tree :global(.blossom-tree) {
    position: absolute;
    right: -12px;
    bottom: 0;
    width: min(490px, 46vw);
  }

  /* ---------- RESEARCH ---------- */
  .research {
    background: var(--paper-2);
    padding-block: clamp(2.75rem, 6vw, 3.5rem);
    position: relative;
    z-index: 2;
  }

  .research-grid {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 3.25rem;
    align-items: start;
  }

  .research-kicker { margin-bottom: 1rem; }

  .research-intro p {
    font-size: 0.84rem;
    font-weight: 300;
    line-height: 1.74;
    color: var(--text-muted);
    margin: 0 0 1.1rem;
  }

  .research-cta {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--clay);
  }

  .research-cta:hover { color: var(--clay-h); }

  .research-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
  }

  .research-card {
    background: var(--paper);
    border-radius: var(--radius-sm);
    padding: 1.4rem 1.15rem 1.15rem;
    transition: var(--transition-hover);
  }

  .research-card:hover {
    box-shadow: var(--shadow-sm);
    transform: translateY(-2px);
  }

  .research-card-title {
    font-size: 0.86rem;
    font-weight: 500;
    line-height: 1.32;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }

  .research-card-blurb {
    font-size: 0.8rem;
    font-weight: 400;
    line-height: 1.64;
    color: var(--text-muted);
    margin: 0;
  }

  /* ---------- SKILLS ---------- */
  .skills {
    background: var(--paper);
    padding-block: clamp(2.5rem, 5vw, 3rem);
    position: relative;
    z-index: 2;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 2.75rem;
  }

  .skill-kicker { margin-bottom: 1.15rem; }

  .skill-items {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .skill-item {
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--ink-soft);
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 900px) {
    .research-grid { grid-template-columns: 1fr; gap: 1.75rem; }
  }

  @media (max-width: 768px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-bio { padding-right: 0; padding-bottom: 2rem; }
    .hero-tree {
      min-height: 0;
      height: 230px;
      order: -1;
      opacity: 0.9;
    }
    .hero-tree :global(.blossom-tree) { width: 300px; right: -20px; }
    .research-cards { grid-template-columns: 1fr; }
    .skills-grid { grid-template-columns: 1fr; gap: 1.75rem; }
  }

  @media (max-width: 420px) {
    .hero-monogram-col { display: none; }
  }
</style>
