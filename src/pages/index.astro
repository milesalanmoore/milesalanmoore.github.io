---
import { getCollection } from "astro:content";
import Layout from "../components/Layout.astro";
import { hero, researchIntro, researchAreas, skills } from "../data/home";
import { publications, pubMeta, boldAuthors } from "../data/publications";
import { socials, email, cvPath } from "../data/socials";

const featured = publications.filter((p) => p.featured).slice(0, 3);

const news = (await getCollection("news", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
---

<Layout title="Miles A. Moore">
  <!-- Hero: portrait, name, role line, short bio -->
  <section class="wrap hero">
    <img
      class="hero-photo"
      src={hero.photo}
      alt={hero.name}
      width="128"
      height="128"
      loading="eager"
    />
    <h1>{hero.name}</h1>
    <p class="hero-roles">{hero.roles.join(" · ")}</p>
    <p class="hero-bio">{hero.bio}</p>
    <p class="hero-aside">{hero.aside}</p>

    <div class="btn-row hero-actions">
      <a class="btn btn-accent" href="/research/">Research &amp; publications</a>
      <a class="btn" href={cvPath}>Curriculum vitae</a>
      <a class="btn" href={`mailto:${email}`}>Get in touch</a>
    </div>
  </section>

  <!-- Research areas -->
  <section class="wrap band">
    <h2>Research</h2>
    <p class="lede">{researchIntro}</p>
    <div class="entries areas">
      {
        researchAreas.map((area) => (
          <div class="entry">
            <h3 class="entry-title">{area.title}</h3>
            <p class="entry-sub">{area.blurb}</p>
            {area.tools && <p class="tools">{area.tools}</p>}
          </div>
        ))
      }
    </div>
  </section>

  <!-- Selected publications -->
  <section class="wrap band">
    <h2>Selected work</h2>
    <div class="entries">
      {
        featured.map((pub) => (
          <article class="entry">
            <div class="entry-meta">
              {pubMeta(pub).map((m) => (
                <span>{m}</span>
              ))}
            </div>
            {pub.slug ? (
              <a class="entry-title" href={`/research/${pub.slug}/`}>
                {pub.title}
              </a>
            ) : (
              <h3 class="entry-title">{pub.title}</h3>
            )}
            <p class="entry-sub" set:html={boldAuthors(pub.authors)} />
          </article>
        ))
      }
    </div>
    <p class="more"><a href="/research/">All publications &amp; datasets →</a></p>
  </section>

  <!-- Recent news -->
  <section class="wrap band">
    <h2>Recent</h2>
    <div class="entries">
      {
        news.map((post) => (
          <article class="entry">
            <div class="entry-meta">
              <span>{fmtDate(post.data.date)}</span>
            </div>
            <a class="entry-title" href={`/news/${post.slug}/`}>
              {post.data.title}
            </a>
            {post.data.description && (
              <p class="entry-sub">{post.data.description}</p>
            )}
          </article>
        ))
      }
    </div>
    <p class="more"><a href="/news/">All news →</a></p>
  </section>

  <!-- Toolkit -->
  <section class="wrap band">
    <h2>Toolkit</h2>
    <div class="cols">
      {
        skills.map((group) => (
          <div>
            <h4>{group.category}</h4>
            <ul>
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Elsewhere -->
  <section class="wrap band">
    <h2>Elsewhere</h2>
    <div class="entries">
      {
        socials.map((s) => (
          <a
            class="link-row"
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="link-label">{s.label}</span>
            <span class="link-handle">{s.handle}</span>
          </a>
        ))
      }
      <a class="link-row" href={`mailto:${email}`}>
        <span class="link-label">Email</span>
        <span class="link-handle">{email}</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-top: 3.5rem;
    padding-bottom: 3rem;
    text-align: center;
  }

  .hero-photo {
    width: 128px;
    height: 128px;
    border-radius: 50%;
    object-fit: cover;
    /* Frames the face in the headshot's off-center composition. */
    object-position: 53% 22%;
    margin: 0 auto 1.75rem;
  }

  .hero h1 {
    font-size: 2.15rem;
    margin-bottom: 0.55rem;
  }

  .hero-roles {
    font-size: 0.95rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  .hero-bio {
    font-size: 1.02rem;
    line-height: 1.85;
    color: var(--ink-2);
    max-width: 54ch;
    margin: 0 auto 1rem;
  }

  .hero-aside {
    font-size: 0.92rem;
    color: var(--faint);
    max-width: 54ch;
    margin: 0 auto 2rem;
  }

  .hero-actions {
    justify-content: center;
  }

  /* Research areas sit tighter than publication entries */
  .areas .entry {
    padding: 1.15rem 0;
  }

  .tools {
    font-size: 0.82rem;
    color: var(--accent);
    margin-top: 0.3rem;
    letter-spacing: 0.01em;
  }

  .more {
    margin-top: 1.35rem;
    font-size: 0.9rem;
  }

  /* Elsewhere: label / handle rows */
  .link-row {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--rule-2);
    color: var(--ink-2);
    font-size: 0.92rem;
  }

  .link-row:first-child {
    border-top: 0;
  }

  .link-row:hover {
    text-decoration: none;
  }

  .link-label {
    color: var(--faint);
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding-top: 0.15rem;
  }

  .link-row:hover .link-handle {
    color: var(--accent);
  }
</style>
