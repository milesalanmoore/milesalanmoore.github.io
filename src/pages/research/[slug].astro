---
/** A detail page for each publication that has a `slug` in publications.ts. */
import Layout from "../../components/Layout.astro";
import { publications, pubMeta, boldAuthors } from "../../data/publications";

export function getStaticPaths() {
  return publications
    .filter((p) => p.slug)
    .map((p) => ({ params: { slug: p.slug }, props: { pub: p } }));
}

const { pub } = Astro.props;
---

<Layout
  title={pub.title}
  description={pub.abstract ?? `${pub.title}. ${pub.journal}, ${pub.year}.`}
>
  <div class="wrap page-head">
    <a class="back-link" href="/research/">← All publications</a>
    <div class="entry-meta">
      {pubMeta(pub).map((m) => <span>{m}</span>)}
    </div>
    <h1 class="pub-title">{pub.title}</h1>
    <p class="authors" set:html={boldAuthors(pub.authors)} />

    {
      pub.links && pub.links.length > 0 && (
        <div class="btn-row links">
          {pub.links.map((link, i) => (
            <a
              class:list={["btn", i === 0 && "btn-accent"]}
              href={link.url}
              target={link.url.startsWith("/") ? undefined : "_blank"}
              rel={link.url.startsWith("/") ? undefined : "noopener noreferrer"}
            >
              {link.text}
            </a>
          ))}
        </div>
      )
    }
  </div>

  {
    pub.abstract && (
      <section class="wrap band">
        <h2>Abstract</h2>
        <div class="prose">
          <p>{pub.abstract}</p>
        </div>
      </section>
    )
  }

  {
    pub.tags && pub.tags.length > 0 && (
      <section class="wrap band">
        <h2>Topics</h2>
        <div class="tags">
          {[...new Set(pub.tags)].map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </section>
    )
  }
</Layout>

<style>
  .pub-title {
    font-size: 1.85rem;
    margin-top: 0.4rem;
    line-height: 1.3;
  }

  .authors {
    margin-top: 0.8rem;
    font-size: 0.95rem;
    color: var(--muted);
  }

  .links {
    margin-top: 1.5rem;
  }
</style>
