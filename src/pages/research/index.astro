---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import Nav from "../../components/layout/Nav.astro";
import Footer from "../../components/layout/Footer.astro";
import PubCard from "../../components/ui/PubCard.astro";
import { publications, datasets } from "../../data/publications";
---

<BaseLayout
  title="Research — Miles A. Moore"
  description="Publications, datasets, and research on Bayesian ecological methods, phenology, and alpine systems."
>
  <Nav />
  <main id="main-content">

    <section class="page-header">
      <div class="container">
        <p class="page-label">Research</p>
        <h1 class="page-heading">Publications &amp; Datasets</h1>
        <p class="page-sub">
          I develop Bayesian and simulation-based methods to study phenology and
          climate interactions in alpine tundra and agricultural systems.
        </p>
      </div>
    </section>

    <!-- Publications -->
    <section class="section">
      <div class="container">
        <h2 class="section-title">Publications</h2>
        <div class="pub-list">
          {publications.map((pub) => <PubCard pub={pub} />)}
        </div>
      </div>
    </section>

    <!-- Presentations -->
    <section class="section section-alt">
      <div class="container">
        <h2 class="section-title">Presentations</h2>
        <div class="presentation-list">
          <div class="presentation-item">
            <div class="pres-meta">
              <span class="pres-venue">AGU Fall Meeting 2023</span>
              <span class="pres-type">Poster</span>
              <span class="pres-date">Dec 2023 · San Francisco, CA</span>
            </div>
            <p class="pres-title">
              From Field to Air: Integrating Field Data in Support of the ABoVE Airborne Campaign
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Datasets -->
    <section class="section">
      <div class="container">
        <h2 class="section-title">Datasets</h2>
        <div class="dataset-list">
          {
            datasets.map((ds) => (
              <div class="dataset-item">
                <div class="dataset-meta">
                  <span class="dataset-repo">{ds.repository}</span>
                  <span class="dataset-year">{ds.year}</span>
                </div>
                <p class="dataset-title">{ds.title}</p>
                <p class="dataset-authors">{ds.authors}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
  .section-alt { background: var(--paper-2); }

  .pub-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  /* Presentations */
  .presentation-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .presentation-item {
    border-left: 2px solid var(--sage);
    padding-left: 1.25rem;
  }

  .pres-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .pres-venue {
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--sage);
  }

  .pres-type {
    font-size: 0.68rem;
    font-weight: 500;
    padding: 0.1rem 0.45rem;
    background: rgba(88, 72, 62, 0.07);
    border-radius: var(--radius-xs);
    color: var(--text-muted);
  }

  .pres-date {
    font-size: 0.76rem;
    color: var(--text-faint);
  }

  .pres-title {
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.4;
    margin: 0;
  }

  /* Datasets */
  .dataset-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 0.85rem;
  }

  .dataset-item {
    background: var(--paper-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 1.1rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: var(--transition-hover);
  }

  .dataset-item:hover {
    box-shadow: var(--shadow-sm);
  }

  .dataset-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dataset-repo {
    font-size: 0.66rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--sage);
  }

  .dataset-year {
    font-size: 0.66rem;
    font-weight: 500;
    color: var(--text-faint);
    padding: 0.1rem 0.45rem;
    background: rgba(88, 72, 62, 0.07);
    border-radius: var(--radius-xs);
  }

  .dataset-title {
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.4;
    margin: 0;
  }

  .dataset-authors {
    font-size: 0.78rem;
    font-weight: 300;
    color: var(--text-muted);
    margin: 0;
  }
</style>
