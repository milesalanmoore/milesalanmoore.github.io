---
import Layout from "../../components/Layout.astro";
import {
  publications,
  datasets,
  pubMeta,
  boldAuthors,
} from "../../data/publications";
import { presentations } from "../../data/cv";
---

<Layout
  title="Research"
  description="Publications, datasets, and presentations on Bayesian ecological methods, phenology, and alpine systems."
>
  <div class="wrap page-head">
    <p class="eyebrow">Research</p>
    <h1>Publications &amp; Datasets</h1>
    <p class="lede">
      I develop Bayesian and simulation-based methods to study phenology and
      climate interactions in alpine tundra and agricultural systems.
    </p>
  </div>

  <section class="wrap band">
    <h2>Publications</h2>
    <div class="entries entries-cards">
      {
        publications.map((pub) => (
          <article class="entry">
            <div class="entry-meta">
              {pubMeta(pub).map((m) => (
                <span>{m}</span>
              ))}
            </div>
            {pub.slug ? (
              <a class="entry-title" href={`/research/${pub.slug}/`}>
                {pub.title}
              </a>
            ) : (
              <h3 class="entry-title">{pub.title}</h3>
            )}
            <p class="entry-sub" set:html={boldAuthors(pub.authors)} />
            {pub.links && pub.links.length > 0 && (
              <div class="entry-links">
                {pub.links.map((link) => (
                  <a
                    href={link.url}
                    target={link.url.startsWith("/") ? undefined : "_blank"}
                    rel={
                      link.url.startsWith("/") ? undefined : "noopener noreferrer"
                    }
                  >
                    {link.text} →
                  </a>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap band">
    <h2>Datasets</h2>
    <div class="entries">
      {
        datasets.map((ds) => (
          <article class="entry">
            <div class="entry-meta">
              <span class="accent">{ds.repository}</span>
              <span>{ds.year}</span>
            </div>
            <h3 class="entry-title">{ds.title}</h3>
            <p class="entry-sub">{ds.authors}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap band">
    <h2>Presentations</h2>
    <div class="entries">
      {
        presentations.map((p) => (
          <article class="entry">
            <div class="entry-meta">
              <span>{p.date}</span>
            </div>
            <h3 class="entry-title">{p.title}</h3>
            <p class="entry-sub">{p.sub}</p>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
