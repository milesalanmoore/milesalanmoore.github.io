---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import Nav from "../../components/layout/Nav.astro";
import Footer from "../../components/layout/Footer.astro";
import Button from "../../components/ui/Button.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const posts = await getCollection("news", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"news">;
}

const { post } = Astro.props;
const { title, date, description, thumbnail, tags, links } = post.data;
const { Content } = await post.render();

const dateStr = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={`${title} — Miles A. Moore`} description={description ?? title}>
  <Nav />
  <main id="main-content">

    <section class="page-header">
      <div class="container">
        <a href="/news/" class="back-link">
          <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
          All news
        </a>
        <time class="post-date" datetime={date.toISOString()}>{dateStr}</time>
        <h1 class="post-title">{title}</h1>
        {description && <p class="post-desc">{description}</p>}

        {
          links && links.length > 0 && (
            <div class="post-links">
              {links.map((link) => (
                <Button
                  href={link.url}
                  variant="ghost"
                  icon={link.icon}
                  external={!link.url.startsWith("/")}
                  size="sm"
                >
                  {link.text}
                </Button>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <article class="section">
      <div class="container post-body">

        {
          thumbnail && (
            <div class="post-thumbnail">
              <Image src={thumbnail} alt={title} width={900} height={500} class="post-thumb-img" />
            </div>
          )
        }

        <div class="prose">
          <Content />
        </div>

        {
          tags && tags.length > 0 && (
            <div class="post-footer-tags">
              {tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          )
        }

        <div class="post-nav">
          <a href="/news/" class="back-link-bottom">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            Back to News
          </a>
        </div>
      </div>
    </article>

  </main>
  <Footer />
</BaseLayout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .back-link:hover { color: var(--clay); gap: 0.55rem; }

  .post-date {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sage);
    margin-bottom: 0.6rem;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--ink);
    line-height: 1.15;
    margin-bottom: 0.85rem;
  }

  .post-desc {
    font-size: 1rem;
    font-weight: 300;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    max-width: 60ch;
  }

  .post-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post-body {
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .post-thumbnail {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .post-thumb-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .post-footer-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-2);
  }

  .back-link-bottom {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--clay);
  }

  .back-link-bottom:hover { color: var(--clay-h); gap: 0.55rem; }
</style>
