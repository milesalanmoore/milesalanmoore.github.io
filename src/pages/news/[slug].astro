---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../components/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("news", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
    // Dates in frontmatter are plain YYYY-MM-DD, parsed as UTC midnight.
    timeZone: "UTC",
  });
---

<Layout title={post.data.title} description={post.data.description}>
  <div class="wrap page-head">
    <a class="back-link" href="/news/">← All news</a>
    <p class="eyebrow">{fmtDate(post.data.date)}</p>
    <h1 class="post-title">{post.data.title}</h1>

    {
      post.data.links.length > 0 && (
        <div class="btn-row links">
          {post.data.links.map((link, i) => (
            <a
              class:list={["btn", i === 0 && "btn-accent"]}
              href={link.url}
              target={link.url.startsWith("/") ? undefined : "_blank"}
              rel={link.url.startsWith("/") ? undefined : "noopener noreferrer"}
            >
              {link.text}
            </a>
          ))}
        </div>
      )
    }
  </div>

  <article class="wrap">
    {
      post.data.thumbnail && (
        <Image
          class="post-image"
          src={post.data.thumbnail}
          alt={post.data.title}
          widths={[480, 680, 1360]}
          sizes="(max-width: 720px) 100vw, 680px"
        />
      )
    }
    <div class="prose">
      <Content />
    </div>

    {
      post.data.tags.length > 0 && (
        <div class="tags post-tags">
          {post.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }
  </article>
</Layout>

<style>
  .post-title {
    font-size: 1.9rem;
    margin-top: 0.35rem;
    line-height: 1.3;
  }

  .links {
    margin-top: 1.4rem;
  }

  .post-image {
    width: 100%;
    height: auto;
    border-radius: 3px;
    margin-bottom: 2rem;
  }

  .post-tags {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }
</style>
