---
import { getCollection } from "astro:content";
import Layout from "../../components/Layout.astro";

const posts = (await getCollection("news", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
    // Dates in frontmatter are plain YYYY-MM-DD, parsed as UTC midnight.
    timeZone: "UTC",
  });
---

<Layout
  title="News"
  description="Updates on research, conferences, fellowships, and coursework."
>
  <div class="wrap page-head">
    <p class="eyebrow">News</p>
    <h1>Updates</h1>
    <p class="lede">Research milestones, conferences, fellowships, and more.</p>
  </div>

  <section class="wrap band">
    <div class="entries">
      {
        posts.map((post) => (
          <article class="entry">
            <div class="entry-meta">
              <span>{fmtDate(post.data.date)}</span>
              {post.data.tags.slice(0, 1).map((t) => (
                <span class="accent">{t}</span>
              ))}
            </div>
            <a class="entry-title" href={`/news/${post.slug}/`}>
              {post.data.title}
            </a>
            {post.data.description && (
              <p class="entry-sub">{post.data.description}</p>
            )}
          </article>
        ))
      }
    </div>
  </section>
</Layout>
